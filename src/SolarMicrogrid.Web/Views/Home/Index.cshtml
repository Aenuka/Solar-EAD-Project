@model DashboardResponse
@{
    ViewData["Title"] = "Overview";
}
<div class="page-heading">
    <div>
        <p class="eyebrow">YOUR COMMUNITY, AT A GLANCE</p>
        <h1>Account overview</h1>
        <p class="muted">Manage the people connected to your microgrid.</p>
    </div>
    <a class="button" asp-controller="Staff" asp-action="Create">+ Add staff member</a>
</div>
<div class="stats-grid">
    <a class="stat-card" asp-controller="Prosumers" asp-action="Index" asp-route-status="Active">
        <span>Active prosumers</span>
        <strong>@Model.ActiveProsumers</strong>
        <small>
            <span class="status-dot"></span> Connected accounts</small>
    </a>
    <a class="stat-card" asp-controller="Prosumers" asp-action="Index" asp-route-pending="true">
        <span>Pending requests</span>
        <strong>@Model.PendingRequests</strong>
        <small>Awaiting your review →</small>
    </a>
    <a class="stat-card" asp-controller="Prosumers" asp-action="Index" asp-route-status="Inactive">
        <span>Inactive prosumers</span>
        <strong>@Model.InactiveProsumers</strong>
        <small>Available for reactivation</small>
    </a>
    <a class="stat-card" asp-controller="Staff" asp-action="Index">
        <span>Team members</span>
        <strong>@Model.StaffUsers</strong>
        <small>Backoffice &amp; Grid Operators</small>
    </a>
</div>
<div class="overview-grid">
    <section class="card welcome-card">
        <p class="eyebrow">ACCOUNT CARE</p>
        <h2>A clear view of every connection.</h2>
        <p>Review prosumer profiles, respond to deactivation requests, and help returning members reconnect.</p>
        <a class="button" asp-controller="Prosumers" asp-action="Index">Explore prosumer accounts →</a>
    </section>
    <section class="card">
        <h2>Workspace essentials</h2>
        <a class="action-row" asp-controller="Prosumers" asp-action="Index" asp-route-pending="true">
            <span>
                <strong>Review deactivation requests</strong>
                <small>Approve or reject with a recorded note.</small>
            </span>
            <span>→</span>
        </a>
        <a class="action-row" asp-controller="Staff" asp-action="Index">
            <span>
                <strong>Manage team access</strong>
                <small>Keep staff roles and account status up to date.</small>
            </span>
            <span>→</span>
        </a>
    </section>
</div>
