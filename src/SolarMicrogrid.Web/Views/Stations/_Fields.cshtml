@model StationInput
<div asp-validation-summary="All" class="validation" role="alert"></div>
<label asp-for="Name">Station name</label><input asp-for="Name" required maxlength="100" />
<label asp-for="Address">Address</label><input asp-for="Address" required maxlength="300" />
<div class="row">
    <div class="col-md-6"><label asp-for="Latitude">Latitude</label><input asp-for="Latitude" type="number" step="any" min="-90" max="90" required /></div>
    <div class="col-md-6"><label asp-for="Longitude">Longitude</label><input asp-for="Longitude" type="number" step="any" min="-180" max="180" required /></div>
</div>
<label asp-for="CapacityKw">Power capacity (kW)</label><input asp-for="CapacityKw" type="number" step="0.01" min="0.01" max="1000000" required />
<label asp-for="StorageKwh">Battery storage (kWh)</label><input asp-for="StorageKwh" type="number" step="0.01" min="0.01" max="1000000" required />
<label asp-for="BatterySlots">Battery slots</label><input asp-for="BatterySlots" type="number" min="1" max="10000" required />
