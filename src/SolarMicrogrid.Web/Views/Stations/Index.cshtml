@model PageResponse<StationResponse>
@{
    ViewData["Title"] = "Microgrid stations";
}
<div class="page-heading">
    <div>
        <h1>Microgrid stations</h1>
        <p class="muted">Manage locations, operating schedules and energy window availability.</p>
    </div>

    @if (User.IsInRole(Roles.Backoffice))
    {
        <a class="button" asp-action="Create">Register station</a>
    }
</div>

@if (Model.Total == 0)
{
    <section class="card">
        <p>No stations registered yet.</p>
    </section>
}
<div class="row">
    @foreach (var s in Model.Items)
    {
        <div class="col-md-6">
            <section class="card">
                <h2>
                    <a asp-action="Details" asp-route-id="@s.Id">@s.Name</a>
                </h2>
                <p>@s.Address</p>
                <p>
                    <strong>@(s.Active ? "Active" : "Inactive")</strong> · @s.CapacityKw kW · @s.StorageKwh kWh · @s.BatterySlots battery slots</p>
                <p>@s.ActiveReservations active reservations</p>
                <p class="muted">@s.Schedule.OpensAt–@s.Schedule.ClosesAt · @s.Schedule.TimeZone</p>
            </section>
        </div>
    }
</div>
<nav aria-label="Station pages">

    @if (Model.Page > 1)
    {
        <a class="button secondary" asp-route-page="@(Model.Page - 1)">Previous</a>
    }
    <span>Page @Model.Page · @Model.Total stations</span>

    @if ((long)Model.Page * Model.PageSize < Model.Total)
    {
        <a class="button secondary" asp-route-page="@(Model.Page + 1)">Next</a>
    }
</nav>
