<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · Solar Microgrid</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @if (ViewContext.RouteData.Values["controller"]?.ToString() == "Stations")
    {
        <link rel="stylesheet" href="~/css/bootstrap-grid.min.css" asp-append-version="true" />
        <link rel="stylesheet" href="~/css/stations.css" asp-append-version="true" />
    }
</head>
<body>
    <a class="skip-link" href="#main">Skip to content</a>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <aside class="sidebar">
            <a class="brand" asp-controller="Home" asp-action="Index">
                <span class="brand-mark" aria-hidden="true">☀</span>
                <span>Solar<span class="brand-sub">MICROGRID</span></span>
            </a>
            <p class="nav-label">WORKSPACE</p>
            <nav aria-label="Main navigation">
                <a asp-controller="Home" asp-action="Index">Overview</a>
                <a asp-controller="Stations" asp-action="Index">Microgrid stations</a>
                <a asp-controller="Bookings" asp-action="Index">Bookings</a>
                @if (User.IsInRole(Roles.Backoffice))
                {
                    <a asp-controller="Prosumers" asp-action="Index">Prosumer accounts</a>
                    <a asp-controller="Prosumers" asp-action="Index" asp-route-pending="true">Deactivation requests</a>
                    <a asp-controller="Staff" asp-action="Index">Team &amp; access</a>
                }
            </nav>
            <div class="sidebar-footer"><span class="status-dot"></span> A connected energy community</div>
        </aside>
        <div class="workspace">
            <header class="topbar">
                <span>Account management</span>
                <div class="user-menu">
                    <span>@User.Identity.Name <small>@(User.IsInRole(Roles.Backoffice) ? "Backoffice" : "Grid Operator")</small></span>
                    <form asp-controller="Account" asp-action="Logout" method="post">
                        <button class="button-quiet" type="submit">Sign out</button>
                    </form>
                </div>
            </header>
            <main id="main" class="content">
                @if (TempData["Success"] is string success) { <div role="status" class="notice success">@success</div> }
                @if (TempData["Error"] is string error) { <div role="alert" class="notice error">@error</div> }
                @RenderBody()
            </main>
            <footer class="page-footer">Smart Solar Microgrid Trading System <span>User &amp; account services</span></footer>
        </div>
    }
    else
    {
        <main id="main">@RenderBody()</main>
    }
</body>
</html>