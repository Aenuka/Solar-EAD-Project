@model ErrorViewModel
@{ ViewData["Title"] = "Unable to complete request"; }
<section class="error-page card"><span class="pill">@Model.StatusCode</span><h1>We couldn’t complete that request</h1><p class="muted">@Model.Message</p><a class="button" asp-controller="Home" asp-action="Index">Return to overview</a><a class="back-link" asp-controller="Account" asp-action="Login">Go to sign in</a></section>
