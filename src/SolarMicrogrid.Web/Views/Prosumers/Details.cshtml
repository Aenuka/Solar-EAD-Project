@model ProsumerEditViewModel
@{
    ViewData["Title"] = Model.Account.FullName;
    var account = Model.Account;
}
<a class="back-link" asp-action="Index">← Prosumer accounts</a>
<div class="page-heading">
    <div>
        <h1>@account.FullName</h1>
        <p class="muted mono">NIC @account.Nic · Joined @account.CreatedAt.ToString("dd MMM yyyy")</p>
    </div>
    <span class="badge @account.Status.ToString().ToLowerInvariant()">@account.Status</span>
</div>
<div class="detail-grid">
    <section class="card">
        <h2>Profile details</h2>
        <p class="muted small">NIC is the account identifier and cannot be changed here.</p>
        <form asp-action="Details" asp-route-id="@account.Nic" method="post">
            <div asp-validation-summary="All" class="validation" role="alert"></div>
            <input asp-for="Version" type="hidden" />
            <label asp-for="FullName">Full name</label>
            <input asp-for="FullName" required />
            <label asp-for="Email">Email address</label>
            <input asp-for="Email" required />
            <label asp-for="Phone">Phone number</label>
            <input asp-for="Phone" type="tel" required />
            <label asp-for="Address">Address</label>
            <textarea asp-for="Address" rows="3" required></textarea>
            <div class="form-actions">
                <button class="button" type="submit">Save profile</button>
                <a asp-action="Details" asp-route-id="@account.Nic">Reload account</a>
            </div>
        </form>
    </section>
    <div class="stack">

        @if (account.DeactivationRequest is { } request)
        {
            <section class="card">
                <div class="section-heading">
                    <h2>Deactivation request</h2>
                    <span class="badge @request.Status.ToString().ToLowerInvariant()">@request.Status</span>
                </div>
                <p class="muted small">Requested @request.RequestedAt.ToString("dd MMM yyyy, HH:mm 'UTC'")</p>
                <blockquote>@request.Reason</blockquote>

                @if (request.Status == RequestStatus.Pending)
                {
                    <p class="muted small">The account stays active until you approve. Approval ends the prosumer’s existing sessions.</p>
                    <form asp-action="Decide" asp-route-id="@account.Nic" method="post">
                        <input type="hidden" name="RequestId" value="@request.Id" />
                        <input type="hidden" name="Version" value="@account.Version" />
                        <label for="decision">Decision</label>
                        <select id="decision" name="Decision" required>
                            <option value="">Choose a decision</option>
                            <option value="Approved">Approve deactivation</option>
                            <option value="Rejected">Reject request</option>
                        </select>
                        <label for="decisionNote">Review note</label>
                        <textarea id="decisionNote" name="Note" minlength="5" maxlength="500" rows="3" required></textarea>
                        <button class="button" type="submit">Submit decision</button>
                    </form>
                }
                else
                {
                    <p class="small">@request.DecisionNote</p>
                    <p class="muted small">Reviewed @request.ReviewedAt?.ToString("dd MMM yyyy, HH:mm 'UTC'")</p>
                }
            </section>
        }

        @if (account.Status == AccountStatus.Inactive)
        {
            <section class="card">
                <h2>Reconnect this account</h2>
                <p class="muted">Reactivation lets the prosumer sign in again with their existing credentials.</p>
                <form asp-action="Reactivate" asp-route-id="@account.Nic" method="post">
                    <input type="hidden" name="Version" value="@account.Version" />
                    <label for="reactivateNote">Reactivation note</label>
                    <textarea id="reactivateNote" name="Note" minlength="5" maxlength="500" rows="3" required></textarea>
                    <button class="button" type="submit">Reactivate account</button>
                </form>
            </section>
        }
        <section class="card">
            <h2>Recent account activity</h2>
            <ol class="timeline">
                @foreach (var entry in account.RecentEvents.Reverse().Take(10))
                {
                    <li>
                        <strong>@System.Text.RegularExpressions.Regex.Replace(entry.Action, "(?<!^)([A-Z])", " $1")</strong>
                        <small>@entry.At.ToString("dd MMM yyyy, HH:mm 'UTC'")</small>

                        @if (entry.Note is not null)
                        {
                            <p>@entry.Note</p>
                        }
                    </li>
                }
            </ol>
        </section>
    </div>
</div>
