@model PageResponse<ProsumerResponse>
@{
    bool pending = ViewBag.Pending == true;
    ViewData["Title"] = pending ? "Deactivation requests" : "Prosumer accounts";
}
<div class="page-heading">
    <div>
        <p class="eyebrow">YOUR ENERGY COMMUNITY</p>
        <h1>@ViewData["Title"]</h1>
        <p class="muted">@(pending ? "Review requests and help members manage their participation." : "Find, update and manage your community’s accounts.")</p>
    </div>
    <span class="pill">@Model.Total @(pending ? "PENDING" : "ACCOUNTS")</span>
</div>
<section class="card table-card">
    <form asp-action="Index" method="get" class="filter-bar">
        <input type="hidden" name="pending" value="@pending.ToString().ToLowerInvariant()" />
        <div class="search-field">
            <label for="search" class="sr-only">Search by name or NIC</label>
            <input id="search" name="search" value="@ViewBag.Search" placeholder="Search by name or NIC" maxlength="100" />
        </div>

        @if (!pending)
        {
            <label for="status" class="sr-only">Status</label>
            <select id="status" name="status">
                <option value="">All statuses</option>
                <option value="Active" selected="@(ViewBag.Status == AccountStatus.Active)">Active</option>
                <option value="Inactive" selected="@(ViewBag.Status == AccountStatus.Inactive)">Inactive</option>
            </select>
        }
        <button class="button secondary" type="submit">Search</button>
    </form>

    @if (Model.Items.Count == 0)
    {
        <div class="empty-state">
            <span class="empty-symbol" aria-hidden="true">☀</span>
            <h2>@(pending ? "You’re all caught up" : "No accounts found")</h2>
            <p class="muted">@(pending ? "New deactivation requests will appear here for review." : "Try another search, or register a prosumer in the Android app.")</p>
        </div>
    }
    else
    {
        <div class="table-scroll">
            <table>
                <thead>
                    <tr>
                        <th>Prosumer</th>
                        <th>NIC</th>
                        <th>Account status</th>
                        <th>Latest request</th>
                        <th>
                            <span class="sr-only">Actions</span>
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model.Items)
                    {
                        <tr>
                            <td>
                                <strong>@user.FullName</strong>
                                <small>@user.Email</small>
                            </td>
                            <td class="mono">@user.Nic</td>
                            <td>
                                <span class="badge @user.Status.ToString().ToLowerInvariant()">@user.Status</span>
                            </td>
                            <td>

                                @if (user.DeactivationRequest is { } request)
                                {
                                    <span class="badge @request.Status.ToString().ToLowerInvariant()">@request.Status</span>
                                }
                                else
                                {
                                    <span class="muted">—</span>
                                }
                            </td>
                            <td>
                                <a asp-action="Details" asp-route-id="@user.Nic">@(pending ? "Review" : "Manage") →</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    <div class="pagination">
        <span>Page @Model.Page · @Model.Total accounts</span>
        <div>

            @if (Model.Page > 1)
            {
                <a asp-action="Index" asp-route-page="@(Model.Page - 1)" asp-route-search="@ViewBag.Search" asp-route-status="@ViewBag.Status" asp-route-pending="@pending">← Previous</a>
            }

            @if (Model.Page * Model.PageSize < Model.Total)
            {
                <a asp-action="Index" asp-route-page="@(Model.Page + 1)" asp-route-search="@ViewBag.Search" asp-route-status="@ViewBag.Status" asp-route-pending="@pending">Next →</a>
            }
        </div>
    </div>
</section>
