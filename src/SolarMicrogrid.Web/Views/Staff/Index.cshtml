@model PageResponse<StaffResponse>
@{ ViewData["Title"] = "Team & access"; }
<div class="page-heading"><div><p class="eyebrow">PEOPLE &amp; PERMISSIONS</p><h1>Team &amp; access</h1><p class="muted">@Model.Total staff accounts across your microgrid.</p></div><a class="button" asp-action="Create">+ Add staff member</a></div>
<section class="card table-card"><div class="table-scroll"><table><thead><tr><th>Team member</th><th>Username</th><th>Role</th><th>Status</th><th><span class="sr-only">Actions</span></th></tr></thead><tbody>
@foreach (var user in Model.Items)
{
    <tr><td><strong>@user.FullName</strong><small>@user.Email</small></td><td>@user.Username @if (user.IsProtected) { <span class="badge">Protected</span> }</td><td>@(user.Role == Roles.GridOperator ? "Grid Operator" : user.Role)</td><td><span class="badge @user.Status.ToString().ToLowerInvariant()">@user.Status</span></td><td><a asp-action="Edit" asp-route-id="@user.Id">Manage <span aria-hidden="true">→</span></a></td></tr>
}
</tbody></table></div>
<div class="pagination"><span>Page @Model.Page · @Model.Total accounts</span><div>@if (Model.Page > 1) { <a asp-action="Index" asp-route-page="@(Model.Page - 1)">← Previous</a> } @if (Model.Page * Model.PageSize < Model.Total) { <a asp-action="Index" asp-route-page="@(Model.Page + 1)">Next →</a> }</div></div></section>
