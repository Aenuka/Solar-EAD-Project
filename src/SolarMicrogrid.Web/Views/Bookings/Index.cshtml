@using SolarMicrogrid.Contracts
@model List<ReservationResponse>

@{
    ViewData["Title"] = "Booking Monitoring";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Booking Monitoring</h2>
        <div>
            <a asp-action="Dashboard" class="btn btn-outline-secondary">Dashboard</a>
            <a asp-action="Pending" class="btn btn-outline-warning">Pending</a>
        </div>
    </div>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">@ViewBag.Error</div>
    }

    <form method="get" class="row g-2 mb-3">
        <div class="col-md-3">
            <input type="text" name="status" class="form-control" placeholder="Status (PENDING/APPROVED/CANCELLED/COMPLETED)" value="@ViewBag.FilterStatus" />
        </div>
        <div class="col-md-3">
            <input type="text" name="stationId" class="form-control" placeholder="Station ID" value="@ViewBag.FilterStation" />
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-primary">Search</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
        </div>
    </form>

    <table class="table table-striped">
        <thead>
            <tr>
                <th>Reservation ID</th>
                <th>Prosumer NIC</th>
                <th>Station</th>
                <th>Slot</th>
                <th>Date</th>
                <th>Energy (kWh)</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                @foreach (var b in Model)
                {
                    <tr>
                        <td>@b.ReservationId</td>
                        <td>@b.ProsumerNic</td>
                        <td>@b.StationId</td>
                        <td>@b.SlotId</td>
                        <td>@b.ReservationDate.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>@b.EnergyAmountKwh</td>
                        <td>
                            <span class="badge @(b.Status == "PENDING" ? "bg-warning text-dark" : b.Status == "APPROVED" ? "bg-success" : b.Status == "COMPLETED" ? "bg-primary" : "bg-secondary")">
                                @b.Status
                            </span>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr><td colspan="7" class="text-center text-muted">No bookings found.</td></tr>
            }
        </tbody>
    </table>
</div>