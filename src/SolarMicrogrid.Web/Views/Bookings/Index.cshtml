@using SolarMicrogrid.Contracts
@model List<ReservationResponse>

@{
    ViewData["Title"] = "Booking Monitoring";
    var total = Model?.Count ?? 0;
    var pending = Model?.Count(b => b.Status == "PENDING") ?? 0;
    var approved = Model?.Count(b => b.Status == "APPROVED") ?? 0;
    var completed = Model?.Count(b => b.Status == "COMPLETED") ?? 0;
}

<div class="page-heading">
    <div>
        <p class="eyebrow">ENERGY TRADING</p>
        <h1>Booking Monitoring</h1>
        <p class="muted">View and monitor all energy reservations across the microgrid.</p>
    </div>
    <div style="display:flex;gap:10px;">
        <a asp-action="Dashboard" class="button secondary">Dashboard</a>
        <a asp-action="Pending" class="button">Review Pending</a>
    </div>
</div>

@if (ViewBag.Error != null)
{
    <div class="notice error">@ViewBag.Error</div>
}

<div class="stats-grid">
    <div class="stat-card">
        <span>Total bookings</span>
        <strong>@total</strong>
        <small>All time reservations</small>
    </div>
    <div class="stat-card">
        <span>Pending</span>
        <strong>@pending</strong>
        <small>Awaiting operator approval</small>
    </div>
    <div class="stat-card">
        <span>Approved</span>
        <strong>@approved</strong>
        <small>Ready for QR verification</small>
    </div>
    <div class="stat-card">
        <span>Completed</span>
        <strong>@completed</strong>
        <small>Energy transfer finalised</small>
    </div>
</div>

<div class="card table-card">
    <form method="get" class="filter-bar">
        <input type="text" name="status" class="search-field" placeholder="Filter by status (PENDING / APPROVED / CANCELLED / COMPLETED)" value="@ViewBag.FilterStatus" />
        <input type="text" name="stationId" class="search-field" placeholder="Filter by station ID" value="@ViewBag.FilterStation" />
        <button type="submit" class="button">Search</button>
        <a asp-action="Index" class="button secondary">Clear</a>
    </form>

    @if (Model != null && Model.Any())
    {
        <div class="table-scroll">
            <table>
                <thead>
                    <tr>
                        <th>Reservation ID</th>
                        <th>Prosumer NIC</th>
                        <th>Station</th>
                        <th>Slot</th>
                        <th>Date &amp; Time</th>
                        <th>Energy (kWh)</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var b in Model)
                    {
                        var badgeClass = b.Status switch
                        {
                            "PENDING" => "badge pending",
                            "APPROVED" => "badge approved",
                            "COMPLETED" => "badge active",
                            "CANCELLED" => "badge inactive",
                            _ => "badge"
                        };
                        <tr>
                            <td><strong>@b.ReservationId</strong></td>
                            <td class="mono">@b.ProsumerNic</td>
                            <td class="mono">@b.StationId</td>
                            <td class="mono">@b.SlotId</td>
                            <td>@b.ReservationDate.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>@b.EnergyAmountKwh</td>
                            <td><span class="@badgeClass">@b.Status</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="empty-state">
            <span class="empty-symbol">☀</span>
            <h2>No bookings found</h2>
            <p class="muted">Bookings will appear here once prosumers create reservations.</p>
        </div>
    }
</div>