@using SolarMicrogrid.Contracts
@model List<ReservationResponse>

@{
    ViewData["Title"] = "Pending Reservations";
}

<div class="page-heading">
    <div>
        <p class="eyebrow">OPERATOR REVIEW</p>
        <h1>Pending Reservations</h1>
        <p class="muted">Reservations awaiting operator approval.</p>
    </div>
    <div style="display:flex;gap:10px;">
        <a asp-action="Index" class="button secondary">All Bookings</a>
        <a asp-action="Dashboard" class="button">Dashboard</a>
    </div>
</div>

@if (ViewBag.Error != null)
{
    <div class="notice error">@ViewBag.Error</div>
}
else if (TempData["Error"] != null)
{
    <div class="notice error">@TempData["Error"]</div>
}

<div class="card table-card">
    <div class="filter-bar" style="justify-content:space-between;">
        <div>
            <strong>Action required</strong>
            <small class="muted" style="display:block;margin-top:4px;">Review and approve pending reservations. Approved bookings become eligible for QR verification.</small>
        </div>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="table-scroll">
            <table>
                <thead>
                    <tr>
                        <th>Reservation ID</th>
                        <th>Prosumer NIC</th>
                        <th>Station</th>
                        <th>Slot</th>
                        <th>Date &amp; Time</th>
                        <th>Energy (kWh)</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var b in Model)
                    {
                        <tr>
                            <td><strong>@b.ReservationId</strong></td>
                            <td class="mono">@b.ProsumerNic</td>
                            <td class="mono">@b.StationId</td>
                            <td class="mono">@b.SlotId</td>
                            <td>@b.ReservationDate.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>@b.EnergyAmountKwh</td>
                            <td><span class="badge pending">@b.Status</span></td>
                            <td>
                                <form method="post" asp-action="Approve" asp-route-id="@b.Id" style="display:inline;">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="button">Approve</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="empty-state">
            <span class="empty-symbol">✓</span>
            <h2>All caught up</h2>
            <p class="muted">No pending reservations at the moment.</p>
        </div>
    }
</div>