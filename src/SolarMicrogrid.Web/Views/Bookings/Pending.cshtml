@model List<SolarMicrogrid.Web.ViewModels.ReservationViewModel>

@{
    ViewData["Title"] = "Pending Reservations";
}

<div class="container mt-4">
    <h2>Pending Reservations</h2>
    <p class="text-muted">Reservations awaiting operator review.</p>

    <table class="table table-striped">
        <thead>
            <tr>
                <th>Reservation ID</th>
                <th>Prosumer NIC</th>
                <th>Station</th>
                <th>Date & Time</th>
                <th>Energy (kWh)</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var b in Model)
            {
                <tr>
                    <td>@b.ReservationId</td>
                    <td>@b.ProsumerNic</td>
                    <td>@b.StationId</td>
                    <td>@b.ReservationDate.ToString("yyyy-MM-dd HH:mm")</td>
                    <td>@b.EnergyAmountKwh</td>
                    <td><span class="badge bg-warning text-dark">@b.Status</span></td>
                </tr>
            }
        </tbody>
    </table>
</div>