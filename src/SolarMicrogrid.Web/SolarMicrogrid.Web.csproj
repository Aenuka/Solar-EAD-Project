<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <RazorCompileOnBuild>false</RazorCompileOnBuild>
    <RazorCompileOnPublish>false</RazorCompileOnPublish>
    <EnableDefaultRazorGenerateItems>false</EnableDefaultRazorGenerateItems>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../SolarMicrogrid.Contracts/SolarMicrogrid.Contracts.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Remove="ClientApp/**" />
    <Content Remove="wwwroot/app/**" />
    <None Remove="ClientApp/node_modules/**" />
    <FrontendSource Include="ClientApp/src/**;ClientApp/index.html;ClientApp/vite.config.js;ClientApp/package.json;ClientApp/package-lock.json" />
  </ItemGroup>
  <Target Name="InstallFrontend" BeforeTargets="BuildFrontend" Inputs="ClientApp/package-lock.json" Outputs="ClientApp/node_modules/.package-lock.json">
    <Exec WorkingDirectory="ClientApp" Command="npm ci --no-audit --no-fund" />
  </Target>
  <Target Name="BuildFrontend" BeforeTargets="BeforeBuild" Inputs="@(FrontendSource)" Outputs="wwwroot/app/index.html">
    <Exec WorkingDirectory="ClientApp" Command="npm run build" />
  </Target>
  <Target Name="IncludeFrontend" BeforeTargets="AssignTargetPaths" DependsOnTargets="BuildFrontend">
    <ItemGroup>
      <Content Include="wwwroot/app/**" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
</Project>
