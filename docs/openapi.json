  "components": {
    "schemas": {
      "AccountEventResponse": {
        "required": [
          "action",
          "actorId",
          "note",
          "at"
        ],
        "type": "object",
        "properties": {
          "action": {
            "type": "string"
          },
          "actorId": {
            "type": "string"
          },
          "note": {
            "type": [
              "null",
              "string"
            ]
          },
          "at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      },
      "AccountStatus": {
        "enum": [
          "Active",
          "Inactive"
        ],
        "type": "string"
      },
      "AuthResponse": {
        "required": [
          "accessToken",
          "expiresAt",
          "tokenType",
          "id",
          "fullName",
          "role"
        ],
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "tokenType": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "fullName": {
            "type": "string"
          },
          "role": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "CreateStaffRequest": {
        "required": [
          "username",
          "fullName",
          "email",
          "password",
          "role"
        ],
        "type": "object",
        "properties": {
          "username": {
            "pattern": "^[a-zA-Z0-9._-]{3,50}$",
            "type": "string"
          },
          "fullName": {
